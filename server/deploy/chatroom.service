# ChatRoom v5 systemd 服务单元（Ubuntu 20.04 / 22.04 / 24.04 / 26.04）
# 由 deploy/install-ubuntu.sh 安装，或手工复制到 /etc/systemd/system/。
# 假定：代码部署在 /opt/chatroom-server，Node 在 /usr/bin/node。
# 若路径不同，请同步修改 WorkingDirectory / ExecStart。

[Unit]
Description=ChatRoom LAN encrypted chat server (v5)
Documentation=file:/opt/chatroom-server/DEPLOY-UBUNTU.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=chatroom
Group=chatroom
WorkingDirectory=/opt/chatroom-server
ExecStart=/usr/bin/node src/main.js
Restart=on-failure
RestartSec=3

# 容量关键项（docs/11）：默认 1024 fd 在约 1000 连接即 EMFILE
LimitNOFILE=65535

# 数据 / 日志外置（paths.js 支持的环境变量）
Environment=CHATROOM_DATA_DIR=/var/lib/chatroom
Environment=CHATROOM_LOG_DIR=/var/log/chatroom

# 可选：启用 HTTPS（语音麦克风需要安全上下文）。证书放到ReadWritePaths之外仍可读。
# Environment=CHATROOM_TLS_CERT=/etc/chatroom/tls/server.crt
# Environment=CHATROOM_TLS_KEY=/etc/chatroom/tls/server.key

# 基础加固：除数据/日志目录外文件系统只读
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/chatroom /var/log/chatroom

# 停止时给 node 一点落盘时间
KillSignal=SIGTERM
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
